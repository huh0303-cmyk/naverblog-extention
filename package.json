{
  "name": "naverblog-extention",
  "version": "0.2.5-rc.1",
  "description": "네이버 계정별 일반 Chrome 창과 확장프로그램으로 연결하는 글쓰기 앱",
  "main": "src/main.js",
  "scripts": {
    "start": "electron scripts/dev-app.js",
    "start:runtime": "electron scripts/dev-app.js",
    "dist": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:mac:arm64": "electron-builder --mac dmg --arm64",
    "dist:mac:x64": "electron-builder --mac dmg --x64"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "author": "BlogAuto contributors",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@ohah/hwpjs": "^0.1.0-rc.10",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "com.local.blogauto.naver",
    "productName": "Naver Blog Automator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "packages/blog-humanizer/index.js",
      "packages/blog-humanizer/package.json",
      "packages/blog-humanizer/references/**/*",
      "packages/blog-humanizer/LICENSE",
      "packages/blog-humanizer/NOTICE",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Naver-Blog-Automator-${version}.${ext}",
      "icon": "src/assets/app-icon.ico"
    },
    "asar": false,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "src/assets/app-icon.png",
      "artifactName": "Naver-Blog-Automator-${version}-${arch}.${ext}"
    }
  }
}
